pipeline {
    agent any
    
    environment {
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Compile') {
            steps {
                sh './gradlew clean compileJava'
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                script {
                    // Forțăm oprirea oricărui container mongo care a rămas "agățat"
                    sh 'docker compose down mongo || true'
                    // Pornim mongo proaspăt
                    sh 'docker compose up -d mongo'
                    sh 'sleep 15'
                }
            }
        }

        stage('Verify & All Tests') {
            steps {
                sh './gradlew test' 
            }
        }
    }

    post {
        always {
            sh 'docker compose down'
        }
    }
}