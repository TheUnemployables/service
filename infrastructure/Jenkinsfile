pipeline {
    agent any
    
    environment {
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Compile') {
            steps {
                sh './gradlew clean compileJava'
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                // Comanda simplă, deoarece fișierul e în root
                sh 'docker compose up -d --build'
                sh 'sleep 20' 
            }
        }

        stage('Verify & All Tests') {
            steps {
                sh './gradlew test' 
            }
        }
    }

    post {
        always {
            // Curățăm containerele la final
            sh 'docker compose down'
        }
    }
}