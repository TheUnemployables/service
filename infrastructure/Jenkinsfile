pipeline {
    agent any
    
    environment {
        // Asigură-te că acest ID de credentiale există în Jenkins (Manage Jenkins -> Credentials)
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Compile') {
            steps {
                // Curățăm și compilăm pentru a ne asigura că Java e ok
                sh './gradlew clean compileJava'
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                script {
                    sh 'chmod +x start_mongo_only.sh stop_mongo_only.sh'
                    
                    // 1. Oprim orice instanță veche care ar putea bloca porturile
                    sh './stop_mongo_only.sh || true'
                    
                    // 2. Pornim MongoDB
                    sh './start_mongo_only.sh'
                    
                    sh 'sleep 20'
                }
            }
        }

        stage('Verify & All Tests') {
            steps {
                // Rulăm testele acum că avem infrastructura pornită
                sh './gradlew test' 
            }
        }
    }

    post {
        always {
            // Folosim scriptul de oprire corespunzător
            sh './stop_mongo_only.sh'
        }
    }
}