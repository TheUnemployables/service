pipeline {
    agent any
    
    environment {
        // Asigură-te că acest ID de credentiale există în Jenkins (Manage Jenkins -> Credentials)
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Compile') {
            steps {
                // Curățăm și compilăm pentru a ne asigura că Java e ok
                sh './gradlew clean compileJava'
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                script {
                    // Debug: Vedem unde suntem și ce fișiere avem
                    sh 'pwd'
                    sh 'ls -la'
                    
                    // Încercăm să pornim serviciile
                    // Am adăugat '-f docker-compose.yml' pentru a fi ultra-expliciți
                    sh 'docker compose -f docker-compose.yml up -d --build'
                    
                    // Așteptăm să se ridice baza de date
                    sh 'sleep 20'
                }
            }
        }

        stage('Verify & All Tests') {
            steps {
                // Rulăm testele acum că avem infrastructura pornită
                sh './gradlew test' 
            }
        }
    }

    post {
        always {
            // Curățăm containerele indiferent dacă testele trec sau pică
            // Folosim aceeași cale explicită ca la pornire
            sh 'docker compose -f docker-compose.yml down'
        }
    }
}