pipeline {
    agent any
    
    environment {
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Compile') {
            steps {
                // Doar compilăm codul, fără să rulăm niciun test încă
                sh './gradlew clean compileJava'
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                // Pornim baza de date și aplicația
                sh 'docker compose up -d --build'
                sh 'sleep 20' 
            }
        }

        stage('Verify & All Tests') {
            steps {
                // Acum că avem baza de date pornită, rulăm TOATE testele
                // Jenkins nu se va mai plânge de MongoTimeout
                sh './gradlew test' 
            }
        }
    }

    post {
        always {
            sh 'docker compose down'
        }
    }
}